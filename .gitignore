# ==========================================
# Godot 4.x .gitignore
# ==========================================

# Godot 4 internal cache and metadata
.godot/
.import/
.nomedia

# Godot export credentials and temporary files
export.cfg
export_credentials.cfg
*.tmp
*.log

# Translation files generated from CSV
*.translation

# ==========================================
# Build Artifacts & Export Outputs
# ==========================================
build/
bin/
dist/
*.apk
*.aab
*.exe
*.dll
*.so
*.dylib
*.pck
*.app
*.ipa

# Android build templates & Gradle caches
android/build/
android/.gradle/
android/app/build/

# Keystores & sensitive credentials (Security)
*.keystore
*.jks
debug.keystore

# ==========================================
# Temporary Screenshots & Media
# ==========================================
screenshot*.png
screenshot*.png.import
table*.png
table*.png.import
new_table*.png
new_table*.png.import
discards_demo*.png
discards_demo*.png.import

# ==========================================
# Operating System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE / Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
